# ==========================================
# CET AI Backend Configuration Template
# IIT Patna Centre for Educational Technology
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM Configuration (Google Gemini - Primary)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=12

# LLM Configuration (OpenRouter - Secondary Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
